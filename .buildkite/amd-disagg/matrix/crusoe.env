# =============================================================================
# crusoe.env — Crusoe Spur site settings for run-slurm-disagg-test.sh.
# -----------------------------------------------------------------------------
# Source it on the Crusoe login node, then set MODEL_NAME and MODEL_DIR (see
# ../example.sh). Every value is `${VAR:-default}`, so the environment wins.
# =============================================================================
export SHARED_MOUNT="${SHARED_MOUNT:-/shared_nfs}"
export LOG_ROOT="${LOG_ROOT:-${SHARED_MOUNT}/${USER:-$(whoami)}/logs}"
export SLURM_LOG_DIR="${SLURM_LOG_DIR:-${LOG_ROOT}}"
export DISAGG_SCRIPTS_STAGE="${DISAGG_SCRIPTS_STAGE:-${SHARED_MOUNT}/${USER:-$(whoami)}/stage}"
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-amd-aifw-di}"
export SLURM_PARTITION="${SLURM_PARTITION:-amd-aig-sw-shared}"
export SLURM_QOS="${SLURM_QOS:-amd-aifw-di-qos}"
# The hosts' libionic is on the 1.0 soname line; images ship 1.1 (see run_xPyD_disagg.slurm).
export SKIP_IONIC_MOUNTS="${SKIP_IONIC_MOUNTS:-1}"
# A path inside the container.
export CLUSTER_ENV_IN="${CLUSTER_ENV_IN:-/vllm-workspace/.buildkite/amd-disagg/cluster_crs.sh}"
